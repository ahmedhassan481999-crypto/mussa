  async function handleLogin(e) {
    e.preventDefault()

    setLoading(true)
    setMessage("")

    try {
      const response = await fetch(
        "/api/login",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({
            username,
            password,
          }),
        }
      )

      const data =
        await response.json()

      if (data.success) {
        setLoggedIn(true)

        localStorage.setItem(
          "mussa_logged_in",
          "true"
        )
      } else {
        setMessage(data.message)
      }
    } catch (error) {
      setMessage(
        "تعذر الاتصال بالسيرفر"
      )
    } finally {
      setLoading(false)
    }
  }

