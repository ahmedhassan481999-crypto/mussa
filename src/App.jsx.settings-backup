  function getInvoiceItemDetails(
    item
  ) {
    const service =
      services.find(
        (serviceItem) =>
          serviceItem.id ===
          Number(
            item.serviceId
          )
      )

    if (!service) {
      return {
        name: "خدمة غير موجودة",
        price: 0,
        unit: "ثابت",
        total: 0,
      }
    }

    const quantity =
      Math.max(
        1,
        Number(
          item.quantity
        ) || 1
      )

    return {
      name: service.name,
      price: Number(
        service.price
      ),
      unit: service.unit,
      total:
        Number(
          service.price
        ) * quantity,
    }
  }

